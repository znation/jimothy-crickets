{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jimothy Crickets",
  "version": "0.1.0",
  "identifier": "com.znation.jimothycrickets",
  "build": {
    "beforeBuildCommand": "npm --prefix ../.. run build",
    "frontendDist": "../../../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Jimothy Crickets",
        "width": 1280,
        "height": 720,
        "minWidth": 667,
        "minHeight": 375,
        "resizable": true,
        "fullscreen": false,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "A cute reverse tower defense game starring Jimothy the raccoon.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
